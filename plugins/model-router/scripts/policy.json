      "why": "a small bug with all its code in the prompt is a scoped fix; run the code to check",
      "max_code_lines": 40
    },
    "named_effort": {
      "floor_class": "risky",
      "ask": "Does the prompt name an effort?",
      "then": "It wins: use the named effort on {where}. Risky work still never goes below {floor}.",
      "why": "the prompt names effort {effort}"
    }
